# ─────────────────────────────────────────────────────────────────────────────
# websites-renderer: omgevingsvariabelen
# Kopieer naar .env.local (lokaal) en zet dezelfde waarden in Vercel.
# Nooit invullen in code, nooit committen.
# ─────────────────────────────────────────────────────────────────────────────

# Dezelfde Supabase als het Minterest-admin (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optioneel en alleen server-side: nodig zodra achtergrondtaken meer moeten dan
# public.get_site_by_domain() (bijv. fase 6, domeinverificatie). Laat leeg tot dan.
SUPABASE_SERVICE_ROLE_KEY=

# Het eigen domein van de renderer. Verzoeken hierop horen bij geen enkele klant.
RENDERER_HOST=sites.minterest.nl
