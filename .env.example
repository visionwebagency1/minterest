# Lead form endpoint — OPTIONAL fallback for contact / start / audit submissions.
# When the Supabase variables below are set, the public forms save straight into
# the `leads` table (the admin inbox) and this endpoint is ignored. With neither
# set, submissions are simulated and logged to the console (development).
#
# Works with any JSON-accepting endpoint, e.g.:
#   Formspree:   https://formspree.io/f/xxxxxxxx
#   Web3Forms:   https://api.web3forms.com/submit   (also needs an access_key field)
#   Own backend: https://api.minterest.nl/leads
#
# Copy this file to `.env` and fill it in.
VITE_FORM_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase. Required for the admin panel (/admin) AND for the public forms to
# save requests into the inbox. The public site uses only the REST endpoint with
# the anon key (it never bundles the Supabase client).
# Find them in your Supabase project: Settings > API.
#   VITE_SUPABASE_URL      = Project URL (e.g. https://xxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = the "anon public" key (safe for the browser, RLS protects data)
# NEVER put the service_role key here or anywhere in the frontend code.
# ─────────────────────────────────────────────────────────────────────────────
# Public site origin used to build shareable offerte/factuur links. Optional;
# defaults to https://minterest.nl so shared links never point at *.vercel.app.
VITE_PUBLIC_BASE_URL=https://minterest.nl

# Google Analytics 4. Optional: set the Measurement ID (G-XXXXXXXXXX) in Vercel to
# turn on analytics. Empty = no analytics loaded. The CSP in vercel.json already
# allows the Google Analytics / Tag Manager domains.
VITE_GA_MEASUREMENT_ID=

VITE_SUPABASE_URL=https://lwvhdzirobwcwlqsmcub.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imx3dmhkemlyb2J3Y3dscXNtY3ViIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI3NTUxNDksImV4cCI6MjA5ODMzMTE0OX0.DCBdxn_r2bQgssv-4yw249tBX_AU3FVIHxugFhKE0zU

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (Resend). SERVER-SIDE ONLY — used by the serverless function
# api/lead-notify.ts to send the confirmation e-mails (customer + Minterest) for
# contact/start/audit forms and online quote approvals. Set these in Vercel:
# Project > Settings > Environment Variables. NO "VITE_" prefix, so they are
# never exposed in the public bundle.
#   RESEND_API_KEY    = your Resend API key (required for e-mails to send)
#   MAIL_FROM         = sender, default "Minterest <info@minterest.nl>"
#   MAIL_TO_INTERNAL  = internal inbox, default "info@minterest.nl"
# The FROM domain must be verified in Resend.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=Minterest <info@minterest.nl>
MAIL_TO_INTERNAL=info@minterest.nl
